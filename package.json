{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@10.9.1",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @workspace/skalena",
    "build": "npm run build --workspace @workspace/skalena",
    "build:all": "npm run typecheck && npm run build --workspaces --if-present",
    "codegen": "npm run codegen --workspace @workspace/api-spec",
    "db:push": "npm run push --workspace @workspace/db",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {}
}
